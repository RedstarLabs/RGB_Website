# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
# Local development may use SQLite. Production credentials must be supplied
# through the deployment environment and must never be committed.
DATABASE_URL=sqlite:///./data/coloremotionstudy.db

# Administrative authentication secrets are intentionally not populated here.
# Define the required secret only in the local or deployment environment after
# the authentication design has been decided.
ADMIN_AUTH_SECRET=
