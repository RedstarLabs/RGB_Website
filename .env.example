# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
# Local development may use SQLite. Production credentials must be supplied
# through the deployment environment and must never be committed.
DATABASE_URL=sqlite:///./coloremotionstudy.db
DEFAULT_TRIAL_COUNT=10

# Administrative authentication secret. Leave empty locally unless needed.
# Never commit a real token.
ADMIN_API_TOKEN=
